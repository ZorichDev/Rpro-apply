# ---------- Backend ----------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/rpro-apply
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# The admin app's own URL — must match whatever port it actually runs on
# (Vite auto-picks the next free port if 5174 is taken, so check your
# terminal output when running `pnpm dev:admin` and update this if it
# shows a different port).
ADMIN_CLIENT_URL=http://localhost:5174

# Optional — if left blank, emails (verification, password reset) are
# logged to the console instead of actually sent. Fill these in to send
# real emails via SMTP (Gmail, Mailtrap, or any provider).
#
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your
# address, SMTP_PASS=an App Password (not your normal Gmail password —
# generate one at https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=R-Pro Apply <no-reply@rprogroup.com.ng>

# PLACEHOLDER key — payment checkout will fail with a clear Flutterwave
# error ("Invalid authorization key" or similar) until this is replaced
# with a real test or live secret key from your Flutterwave dashboard
# (Settings > API Keys). Get a free test key by signing up at
# https://dashboard.flutterwave.com — no live business verification
# needed just to test in sandbox mode.
FLW_SECRET_KEY=FLWSECK_TEST-0000000000000000000000000000-X
FLW_CURRENCY=USD

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:5000/api
